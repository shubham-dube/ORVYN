# PRODUCTION values for the API (Google Cloud). Do NOT commit real values - paste them into the host's env settings.
# Domain isn't final yet: replace yourdomain.com once you have chosen the hostnames (web = app., api = api.).
NODE_ENV=production
PORT=4000
PROCESS_ROLE=all

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432) or Direct
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Redis (see notes: Upstash free tier will run out of commands; prefer Redis on the same VM or Redis Cloud)
REDIS_URL=rediss://default:<password>@<host>:<port>

API_URL=https://api.yourdomain.com
WEB_URL=https://app.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=ORVYN
WEBAUTHN_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=chrome-extension://<your-extension-id>,tauri://localhost
OWNER_EMAIL=you@example.com

# openssl rand -base64 48  (each)
JWT_SECRET=
TOKEN_PEPPER=
# openssl rand -base64 32  (each) - back these up; losing FILES_MASTER_KEY makes stored files unreadable
FILES_MASTER_KEY=
CALENDAR_TOKEN_KEY=

# Google Cloud Console -> APIs & Services -> Credentials (OAuth client, type Web)
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

RESEND_API_KEY=
MAIL_FROM=ORVYN <orvyn@yourdomain.com>

# Cloudflare R2
FILES_STORE=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

OPENROUTER_API_KEY=
AI_DAILY_BUDGET_USD=1
AI_BUDGET_TZ=Asia/Kolkata

# Optional
FCM_SERVICE_ACCOUNT_B64=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SENTRY_DSN=
EXTENSION_IDS=
LOG_LEVEL=info

# ---- Vercel (web project) environment variables ----
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_GOOGLE_ENABLED=1
