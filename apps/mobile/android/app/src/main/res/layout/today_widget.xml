<?xml version="1.0" encoding="utf-8"?>
<!-- Today on the home screen: filled by TodayWidget.kt from the app's snapshot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/orvyn_text"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="@string/widget_add"
            android:gravity="center"
            android:text="@string/widget_plus"
            android:textColor="@color/orvyn_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/widget_clear"
        android:textColor="@color/orvyn_muted"
        android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/when0"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/orvyn_accent"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/orvyn_text"
                android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/when1"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/orvyn_accent"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/orvyn_text"
                android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/when2"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/orvyn_accent"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/orvyn_text"
                android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/when3"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/orvyn_accent"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/title3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/orvyn_text"
                android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/when4"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/orvyn_accent"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/title4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/orvyn_text"
                android:textSize="14sp"/>
        </LinearLayout>

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/orvyn_faint"
        android:textSize="12sp"
        android:visibility="gone"/>
</LinearLayout>
