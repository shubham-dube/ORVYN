{
  "name": "@orvyn/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && vite build -c vite.content.config.ts",
    "build:dev": "vite build --mode development && vite build -c vite.content.config.ts --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "build:store": "vite build --mode store && vite build -c vite.content.config.ts --mode store",
    "build:e2e": "vite build --mode e2e && vite build -c vite.content.config.ts --mode e2e"
  },
  "dependencies": {
    "@orvyn/activity": "workspace:*",
    "@orvyn/contracts": "workspace:*",
    "@orvyn/design-tokens": "workspace:*",
    "@orvyn/money": "workspace:*",
    "@orvyn/vault-crypto": "workspace:*",
    "lucide-react": "^0.460.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
