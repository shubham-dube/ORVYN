{
  "name": "@orvyn/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib",
    "e2e": "pnpm --filter @orvyn/api... build && pnpm --filter @orvyn/extension exec vite build --mode e2e && NEXT_PUBLIC_API_URL=http://localhost:4100 next build && playwright test --trace off",
    "test": "vitest run test"
  },
  "dependencies": {
    "@orvyn/contracts": "workspace:*",
    "@orvyn/design-tokens": "workspace:*",
    "@orvyn/sync-client": "workspace:*",
    "@orvyn/today-parse": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "geist": "^1.9.2",
    "lucide-react": "^0.460.0",
    "motion": "^12.43.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5"
  }
}
