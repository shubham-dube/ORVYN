# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://orvyn:orvyn@localhost:5432/orvyn_dev
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# extra CORS origins, comma separated (chrome-extension://<id>, tauri://localhost)
CORS_ORIGINS=
# the first sign-in with this email becomes the owner
OWNER_EMAIL=you@example.com
# generate: openssl rand -base64 48
JWT_SECRET=
TOKEN_PEPPER=
COOKIE_DOMAIN=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ORVYN
WEBAUTHN_ORIGINS=http://localhost:3000
# Google sign-in (optional until configured)
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Google Calendar uses the same web client (+ redirect URI <API_URL>/calendar/google/callback).
# 32 random bytes, base64 (openssl rand -base64 32); encrypts each connected account's tokens.
# Optional locally (a development key is used), required in production.
CALENDAR_TOKEN_KEY=
# AI (ADR-0010): ORVYN's own OpenRouter key; $1/day cap (D19). AI_PROVIDER=fake answers with rules (no key).
OPENROUTER_API_KEY=
AI_PROVIDER=
AI_DAILY_BUDGET_USD=1
# WhatsApp reminders (D23): Meta WhatsApp Business Cloud API (phone number id, token, one approved template with a
# single body variable). Without these the WhatsApp way is switched off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=orvyn_reminder
WHATSAPP_LANG=en
# Files (ADR-0011): openssl rand -base64 32 (optional locally, required in production). Local dir or R2 (s3).
FILES_MASTER_KEY=
FILES_STORE=local
FILES_DIR=./.data/files
# Chrome extension ids allowed to connect (comma separated; your unpacked dev id + the store id)
EXTENSION_IDS=
# Email; without a key mail goes to the dev outbox (GET /dev/mailbox?email=)
RESEND_API_KEY=
MAIL_FROM=ORVYN <orvyn@dubey.app>
# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dubey.app
# FCM HTTP v1 service account JSON, base64
FCM_SERVICE_ACCOUNT_B64=
# sign-in codes per email per 15 min (raise locally if you keep testing)
AUTH_CODE_LIMIT=3
# error tracking (GlitchTip DSN); empty = off
SENTRY_DSN=
LOG_LEVEL=info
