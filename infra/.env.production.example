# Server-side settings for infra/docker-compose.yml. On the server: /opt/orvyn/infra/.env (chmod 600). Never commit it.
# Generate secrets with: openssl rand -base64 48
DOMAIN=orvyn.dubey.app
OWNER_EMAIL=you@example.com

POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_PEPPER=

# Email (Resend; the domain must be verified there)
RESEND_API_KEY=
MAIL_FROM=ORVYN <orvyn@dubey.app>

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker command shows it)
CLOUDFLARE_TUNNEL_TOKEN=

# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
FCM_SERVICE_ACCOUNT_B64=
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
EXTENSION_IDS=
NEXT_PUBLIC_GOOGLE_ENABLED=0
# chrome-extension://<id>,tauri://localhost once the extension/desktop app are installed
CORS_ORIGINS=

# Backups → Cloudflare R2 (bucket orvyn-backups; an R2 API token limited to that bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_TARGET=r2:orvyn-backups
# age public key (age-keygen prints it); the private half goes to infra/secrets/backup-identity.txt + your password manager
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=35
# Uptime Kuma "Push" monitor URLs (status page → add monitor → Push)
BACKUP_HEARTBEAT_URL=
RESTORE_HEARTBEAT_URL=

# Error tracking (GlitchTip at errors.<DOMAIN>); DSN from its project settings after first login
GLITCHTIP_SECRET_KEY=
GLITCHTIP_REGISTRATION=false
SENTRY_DSN=
